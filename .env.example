# Copy to .env and replace every placeholder. Never commit .env.

DATABASE_URL=jdbc:postgresql://postgres:5432/privacygateway
DATABASE_USERNAME=privacygateway
DATABASE_PASSWORD=change-me
VAULT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VAULT_HASH_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Ollama — pick one:
# Compose ollama service:
OLLAMA_BASE_URL=http://ollama:11434
# Mac/Linux host Ollama while backend runs in Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

JWT_SECRET=replace-with-a-long-random-dev-secret-at-least-32b
PRIVACY_DETECTOR_URL=http://privacy-detector:8000
PRIVACY_DETECTOR_TOKEN=replace-with-detector-shared-secret
TOKEN_TTL_HOURS=24

# Local demo UI: POST /api/v1/dev/token. Set false before any non-local deploy.
DEV_TOKEN_ENABLED=true
